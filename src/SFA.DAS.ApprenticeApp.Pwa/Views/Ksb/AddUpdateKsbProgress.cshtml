@using SFA.DAS.ApprenticeApp.Pwa.ViewHelpers
@using TaskStatus = SFA.DAS.ApprenticeApp.Domain.Models.TaskStatus
@model SFA.DAS.ApprenticeApp.Pwa.ViewModels.EditKsbPageModel

@{
    ViewData["Title"] = "Manage a knowledge, skill or behaviour (KSB)";
    ViewData["Section"] = "Ksbs";
    ViewBag.HideNavigation = false;
    Layout = "_Layout";

    // Passed to the task edit page so its back link returns here rather than to the task list.
    var returnUrl = Url.Action("AddUpdateKsbProgress", "Ksb", new { id = Model.KsbProgress?.KsbId });
}
@section BackLink {
    <a class="govuk-back-link app-back-link" asp-controller="Ksb" asp-action="Index">Back</a>
}

<h1 class="govuk-heading-xl">
    @Model.KsbProgress.KsbKey
</h1>
<p class="govuk-body">@Model.KsbDetail</p>
<partial name="_HelpKSBs.cshtml" />
        <form method="post" asp-controller="Ksb" asp-action="AddUpdateKsbProgress" enctype="multipart/form-data"
              class="form submit-form">

              <div class="govuk-form-group">
                <label class="govuk-label govuk-label--l" asp-for="@Model.KsbProgress.CurrentStatus">
                    KSB status
                </label>
                <select class="govuk-select" id="CurrentStatus" name="currentstatus">
                    @foreach (var ksbStatus in Model.KsbStatuses)
                    {
                         if (Model.KsbProgress.CurrentStatus == ksbStatus)
            {
                <option value="@ksbStatus" selected>
                    @ksbStatus.GetEnumDescription()
                </option>
            }
            else
            {
                <option value="@ksbStatus">
                    @ksbStatus.GetEnumDescription()
                </option>
            }
                    }
                </select>
            </div>             

             <h2 class="govuk-heading-l">Notes and evidence for @Model.KsbProgress.KsbKey</h2>
            @if (Model.KsbProgress.Tasks != null && Model.KsbProgress.Tasks.Count > 0)
            {
                <div class="govuk-grid-row">
                 <div class="govuk-grid-column-one-third app-column-sticky">
                     <div class="app-fab-wrapper">
                    <a href="@Url.Action("Add", "Tasks")" class="govuk-button app-button--full-width">
                        <span>Add note or evidence</span>
                    </a>
                    </div>
                </div>
                <div class="govuk-grid-column-two-thirds" id="ksb-tasks">
                <partial name="_SortBy.cshtml" view-data='@(new ViewDataDictionary(ViewData) { { "Tab", "todo" } })' />    
                        @foreach (var task in Model.KsbProgress.Tasks)
                        {
                        <div class="app-card">
                        <a href="@Url.Action("Edit", "Tasks", new { id = task.TaskId, returnUrl = returnUrl})">
                            <div class="app-card__header">
                                <h2 class="app-card__heading">@task.Title</h2>                                
                            </div> 
                            </a>   
                            <p>@task.Note</p>
                             <dl class="govuk-list govuk-list--spaced app-task-meta">                  
                    <dt class="app-icon-item__text">Date</dt>
                    <dd class="app-icon-item__text">@string.Format("{0:d MMMM yyyy}", task.DueDate)</dd>
                          @if (task.TaskLinkedKsbs != null)
                    {
                    <dt class="app-icon-item__text">Linked to</dt>
                    <dd class="app-icon-item__text">
                        @task.TaskLinkedKsbs.Count
                        @(task.TaskLinkedKsbs.Count > 1 ? "KSBs" : "KSB")
                    </dd>
                    }
                </dl>                    
                                </div>
                            }
                            </div>
                        </div>
            } else {
                <div class="govuk-grid-column-one-third app-column-sticky">
                    <a href="@Url.Action("Add", "Tasks")" class="govuk-button app-button--full-width app-fab">
                        <span>Add note or evidence</span>
                    </a>
                </div>
                <p class="govuk-hint">You have no notes of evidence for this KSB. Add a note to get started.</p>                 
            
            }

            <input type="hidden" id="ksbProgressId" name="KsbProgressId" value="@Model.KsbProgress.KsbProgressId" />
            <input type="hidden" id="KsbId" name="KsbId" value="@Model.KsbProgress.KsbId" />
            <input type="hidden" id="KsbKey" name="KsbKey" value="@Model.KsbProgress.KsbKey" />
            <input type="hidden" id="KsbProgressType" name="KsbProgressType" value="@Model.KsbProgress.KsbProgressType" />            
        </form>  

        <script>
            document.addEventListener("DOMContentLoaded", function () {
        const statusSelect = document.getElementById("CurrentStatus");
        const form = statusSelect.closest("form");
        const originalValue = statusSelect.value;

        statusSelect.addEventListener("change", function () {
            if (statusSelect.value !== originalValue) {
                form.submit();
            }
        });
    });
        </script>
