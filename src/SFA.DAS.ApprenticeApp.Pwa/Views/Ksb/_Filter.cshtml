@using SFA.DAS.ApprenticeApp.Application
@using Microsoft.AspNetCore.WebUtilities

@{
    var savedFilters = QueryHelpers.ParseQuery(
        Context.Request.Cookies[Constants.KsbFiltersCookieName] ?? string.Empty);

    var selectedStatuses = savedFilters.TryGetValue("filter", out var statuses)
        ? statuses.ToArray()
        : Array.Empty<string>();

    var selectedOthers = savedFilters.TryGetValue("other-filter", out var others)
        ? others.ToArray()
        : Array.Empty<string>();

    var keyword = savedFilters.TryGetValue("keyword", out var keywords)
        ? keywords.ToString()
        : string.Empty;

    var hasFilters = selectedStatuses.Length > 0 ||
                     selectedOthers.Length > 0 ||
                     !string.IsNullOrWhiteSpace(keyword);
}

<details class="govuk-details app-details" id="filterKSBs" open="@hasFilters">
    <summary class="govuk-details__summary">
        <span class="govuk-details__summary-text app-details__show-text">
            Show search and filters
        </span>
        <span class="govuk-details__summary-text app-details__hide-text">
            Hide search and filters
        </span>
    </summary>
    <form class="govuk-!-margin-top-4" action="@Url.Action("ApplyFilters", "Ksb")" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="searchTerm" value="@Context.Request.Query["searchTerm"].ToString()" />

        <div class="app-card app-card--highlight">
            <div class="app-card__heading">
                <h2 class="govuk-heading-m">Filters</h2>
            </div>
            <div id="filters-set" class="app-tag__wrapper">
                @foreach (var filter in savedFilters)
                {
                    if (filter.Key != "filter" &&
                        filter.Key != "other-filter" &&
                        filter.Key != "keyword")
                    {
                        continue;
                    }

                    foreach (var value in filter.Value)
                    {
                        if (string.IsNullOrWhiteSpace(value))
                        {
                            continue;
                        }

                        var label = filter.Key == "keyword"
                            ? value
                            : value.Replace("-", " ");

                        var removeValue = filter.Key == "keyword"
                            ? "keyword"
                            : filter.Key + ":" + value;

                        <div class="app-tag app-tag--filter">
                            <span>@label</span>
                            <button type="submit"
                                    name="removeFilter"
                                    value="@removeValue"
                                    class="app-tag__action app-tag__action--remove">
                                <span class="govuk-visually-hidden">
                                    Remove @label from your filters
                                </span>
                            </button>
                        </div>
                    }
                }

                @if (!hasFilters)
                {
                    <span class="govuk-hint">No filters selected</span>
                }
            </div>
            <div class="app-card__body">
                <div class="govuk-form-group">
                    <label class="govuk-label govuk-label--s" for="keyword-filter">
                        Keywords
                    </label>
                    <input class="govuk-input" id="keyword-filter" name="keyword" type="search" placeholder="Search for..." value="@keyword" />
                </div>
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-one-half">
                        <fieldset class="govuk-fieldset govuk-!-margin-bottom-4">
                            <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">
                                Status filters
                            </legend>
                            <div class="govuk-checkboxes govuk-checkboxes--small"
                                 data-module="govuk-checkboxes">
                                <div class="govuk-checkboxes__item">
                                    <input class="govuk-checkboxes__input"
                                           id="not-started"
                                           name="filter"
                                           type="checkbox"
                                           value="not-started"
                                           checked="@(selectedStatuses.Contains("not-started"))" />
                                    <label class="govuk-label govuk-checkboxes__label" for="not-started">
                                        <span>Not started</span>
                                    </label>
                                </div>

                                <div class="govuk-checkboxes__item">
                                    <input class="govuk-checkboxes__input"
                                           id="in-progress"
                                           name="filter"
                                           type="checkbox"
                                           value="in-progress"
                                           checked="@(selectedStatuses.Contains("in-progress"))" />
                                    <label class="govuk-label govuk-checkboxes__label" for="in-progress">
                                        <span>In progress</span>
                                    </label>
                                </div>

                                <div class="govuk-checkboxes__item">
                                    <input class="govuk-checkboxes__input"
                                           id="ready-for-review"
                                           name="filter"
                                           type="checkbox"
                                           value="ready-for-review"
                                           checked="@(selectedStatuses.Contains("ready-for-review"))" />
                                    <label class="govuk-label govuk-checkboxes__label"
                                           for="ready-for-review">
                                        <span>Ready for review</span>
                                    </label>
                                </div>

                                <div class="govuk-checkboxes__item">
                                    <input class="govuk-checkboxes__input"
                                           id="completed"
                                           name="filter"
                                           type="checkbox"
                                           value="completed"
                                           checked="@(selectedStatuses.Contains("completed"))" />
                                    <label class="govuk-label govuk-checkboxes__label" for="completed">
                                        <span>Completed</span>
                                    </label>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                    <div class="govuk-grid-column-one-half">
                        <fieldset class="govuk-fieldset">
                            <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">
                                Other filters
                            </legend>
                            <div class="govuk-checkboxes govuk-checkboxes--small"
                                 data-module="govuk-checkboxes">
                                <div class="govuk-checkboxes__item">
                                    <input class="govuk-checkboxes__input"
                                           id="linked-to-a-task"
                                           name="other-filter"
                                           type="checkbox"
                                           value="linked-to-a-task"
                                           checked="@(selectedOthers.Contains("linked-to-a-task"))" />
                                    <label class="govuk-label govuk-checkboxes__label"
                                           for="linked-to-a-task">
                                        Linked to a task
                                    </label>
                                </div>
                            </div>

                       
                        </fieldset>
                    </div>
                </div>
                <button type="submit" class="govuk-button govuk-!-margin-bottom-0 govuk-!-margin-top-3">Apply filters</button>
            </div>
        </div>
    </form>
</details>