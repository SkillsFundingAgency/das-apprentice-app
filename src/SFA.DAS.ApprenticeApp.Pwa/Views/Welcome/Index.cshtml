@model SFA.DAS.ApprenticeApp.Pwa.ViewModels.WelcomePageModel
@{
    ViewData["Title"] = "Welcome";
    ViewBag.HideNavigation = true;
    ViewBag.HideCrown = true;
    Layout = "_Layout";

    var imagePath = Url.Content($"~/assets/images/onboarding/{Model.Step.Image}.svg");
    var mobileImagePath = Url.Content($"~/assets/images/onboarding/{Model.Step.Image}-mobile.svg");
}

@* Each screen is its own page, so the tour needs no JavaScript to move between them. *@
<div class="app-onboarding">
    <div class="app-onboarding__screen">
        @if (!Model.IsFirst)
        {
            <a href="@Url.Action("Index", "Welcome", new { step = Model.Number - 1 })" class="govuk-back-link app-back-link app-onboarding__back">Back</a>
        }
        <h1 class="govuk-heading-xl">@Model.Step.Heading</h1>
        <span class="govuk-caption-l app-onboarding__step-count">@Model.Number of @Model.Total</span>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                @foreach (var paragraph in Model.Step.Body)
                {
                    <p class="govuk-body">@paragraph</p>
                }
                @if (Model.Step.ListItems?.Length > 0)
                {
                    <ul class="govuk-list govuk-list--bullet">
                        @foreach (var item in Model.Step.ListItems)
                        {
                            <li>@item</li>
                        }
                    </ul>
                }
            </div>
            <div class="govuk-grid-column-one-half">
                @if (Model.Step.HasMobileImage)
                {
                    <img src="@imagePath" alt="@Model.Step.ImageAlt" class="app-onboarding__image--desktop" height="240" />                    
                }
                else
                {
                    <img src="@imagePath" alt="@Model.Step.ImageAlt" class="app-onboarding__image" height="240" />
                }
            </div>
        </div>
        <div class="app-onboarding__actions">
            <a class="govuk-link govuk-link--no-visited-state app-onboarding__skip" asp-controller="Ksb" asp-action="Index">Skip tour</a>
            @if (Model.IsLast)
            {
                <a class="govuk-button app-onboarding__next" asp-controller="Ksb" asp-action="Index">Continue to homepage</a>
            }
            else
            {
                <a class="govuk-button app-onboarding__next" href="@Url.Action("Index", "Welcome", new { step = Model.Number + 1 })">Next</a>
            }
        </div>
    </div>
</div>
