@using SFA.DAS.ApprenticeApp.Pwa.Configuration
@using SFA.DAS.ApprenticeApp.Web.Extensions

@inject ApplicationConfiguration applicationConfiguration
@using SFA.DAS.ApprenticeApp.Pwa.ViewModels
@{
    ViewData["Title"] = "Notifications";
    ViewData["Section"] = "Notifications";
    Layout = "_Layout";
}

@model NotificationPageModel

<h1 class="govuk-heading-xl">Notifications</h1>

@if(Model.SurveyNotificationSeen == false)
{
    @await Html.PartialAsync("_Notifications", Model)
}
else if (
    (Model.TaskReminders == null || Model.TaskReminders.Count == 0)
    &&
    (Model.LearnerNotifications == null || Model.LearnerNotifications.Count == 0)
)
{
    @await Html.PartialAsync("_NoNotifications")
}
else
{
    @await Html.PartialAsync("_Notifications", Model)
}
<script>
    let learnerNotificationsAcknowledged = false;

    function acknowledgeLearnerNotifications() {
        if (learnerNotificationsAcknowledged) {
            return;
        }

        learnerNotificationsAcknowledged = true;

        const url = '@Url.Action("AcknowledgeLearnerNotifications", "Notifications")';

        if (navigator.sendBeacon) {
            navigator.sendBeacon(url);
        } else {
            fetch(url, {
                method: 'POST',
                keepalive: true
            });
        }
    }

    window.addEventListener('pagehide', acknowledgeLearnerNotifications);
</script>